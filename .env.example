# Copy to .env for local use, or add these in Vercel → Project → Settings → Environment Variables

# Get a free key at https://resend.com  (API Keys → Create)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages are delivered (your inbox). With Resend's sandbox sender this must be the
# email you signed up to Resend with; after verifying your own domain it can be any address.
CONTACT_TO=rajupatel8848@gmail.com

# Optional: a sender on your verified domain, e.g.  Portfolio <hello@yourdomain.com>
# CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional: only if the site and the API live on different domains (comma separated)
# ALLOWED_ORIGIN=https://your-domain.com

# Optional: also email the visitor a thank-you (needs a verified domain in Resend)
# SEND_AUTOREPLY=true

# Optional: Discord / Slack incoming-webhook URL for an instant ping
# NOTIFY_WEBHOOK_URL=

# Local testing: log messages instead of sending them
# MAIL_DRY_RUN=1
